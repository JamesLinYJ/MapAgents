{
  "name": "@geo-agent-platform/desktop",
  "private": true,
  "version": "0.1.0",
  "productName": "GeoForge",
  "description": "GeoForge 地理智能工作台",
  "author": {
    "name": "GeoForge"
  },
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24 <25"
  },
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.renderer.json && tsc --noEmit -p tsconfig.node.json",
    "build": "npm run typecheck && electron-vite build",
    "package": "node ../../scripts/require-node24.mjs && npm --prefix ../.. run build:desktop && electron-forge package --platform win32 --arch x64",
    "make": "node ../../scripts/require-node24.mjs && npm --prefix ../.. run build:desktop && pwsh -NoProfile -ExecutionPolicy Bypass -File ../../scripts/prepare-squirrel-vendor.ps1 && electron-forge make --platform win32 --arch x64",
    "make:release": "pwsh -NoProfile -ExecutionPolicy Bypass -File ../../scripts/make-desktop-release.ps1",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run src",
    "test:watch": "vitest src"
  },
  "devDependencies": {
    "@better-auth/electron": "1.6.25",
    "@dagrejs/dagre": "^1.1.8",
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron/fuses": "1.8.0",
    "@electron/windows-sign": "1.2.2",
    "@eslint/js": "^9.39.4",
    "@geo-agent-platform/conversation-presentation": "file:../../packages/conversation-presentation",
    "@geo-agent-platform/operations-supervisor": "file:../../packages/operations-supervisor",
    "@geo-agent-platform/shared-types": "file:../../packages/shared-types",
    "@hookform/resolvers": "^5.4.0",
    "@radix-ui/react-accordion": "^1.2.16",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-tabs": "^1.1.17",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.5",
    "@types/archiver": "8.0.0",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "@xyflow/react": "^12.11.2",
    "archiver": "8.0.0",
    "better-auth": "1.6.25",
    "conf": "15.1.0",
    "date-fns": "^4.4.0",
    "electron": "43.2.0",
    "electron-log": "5.4.4",
    "electron-vite": "5.0.0",
    "electron-window-state": "5.0.3",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "form-data": "4.0.4",
    "framer-motion": "^12.38.0",
    "globals": "^17.4.0",
    "lucide-react": "^0.546.0",
    "maplibre-gl": "^5.11.0",
    "microsoft-cognitiveservices-speech-sdk": "^1.50.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.81.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "4.12.2",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "7.3.6",
    "vitest": "^4.0.8",
    "zod": "^4.3.6",
    "zustand": "^5.0.14"
  }
}
