{
  "id": "geo-platform-automation-execution",
  "name": "自动化流程执行",
  "version": "1.1.0",
  "author": "OpenAI Codex",
  "language": "typescript",
  "description": "查询并执行允许由智能体调用的已发布自动化流程。",
  "tools": [
    {
      "name": "list_automations",
      "label": "查询可用自动化流程",
      "description": "列出当前工作区中允许由智能体同步调用的已发布自动化流程。",
      "group": "自动化流程",
      "tags": ["automation", "system"],
      "isReadOnly": true,
      "isDestructive": false,
      "executionSurfaces": ["agent", "debug"],
      "jsonSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "execute_automation",
      "label": "执行会话自动化流程",
      "description": "在当前对话运行中执行一条已发布的确定性自动化流程，并返回输出节点的权威回答与产物供后续交付步骤使用。",
      "group": "自动化流程",
      "tags": ["automation", "system"],
      "isReadOnly": false,
      "isDestructive": false,
      "executionSurfaces": ["agent", "debug"],
      "agentResultMode": "continue",
      "jsonSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "automation_id": {
            "type": "string",
            "description": "必须来自 list_automations 返回结果的 automationId。"
          },
          "prompt": {
            "type": "string",
            "description": "需要交给自动化流程的完整用户目标。"
          },
          "parameters": {
            "type": "object",
            "description": "符合目标自动化流程参数 Schema 的显式参数。",
            "additionalProperties": true
          }
        },
        "required": ["automation_id", "prompt"]
      }
    },
    {
      "name": "list_automation_runs",
      "label": "查询自动化运行记录",
      "description": "列出当前会话或当前对话中已经持久化的自动化运行记录。",
      "group": "自动化流程",
      "tags": ["automation", "system"],
      "isReadOnly": true,
      "isDestructive": false,
      "executionSurfaces": ["agent", "debug"],
      "jsonSchema": {
        "type": "object",
        "properties": {
          "scope": {
            "type": "string",
            "enum": ["session", "thread"],
            "default": "session",
            "description": "查询范围。session 可跨当前会话中的对话复用结果；thread 仅查询当前对话。"
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "read_automation_run",
      "label": "读取自动化运行结果",
      "description": "读取当前会话中一条自动化运行的持久化输出和关联产物。",
      "group": "自动化流程",
      "tags": ["automation", "system"],
      "isReadOnly": true,
      "isDestructive": false,
      "executionSurfaces": ["agent", "debug"],
      "jsonSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "automation_run_ref": {
            "type": "string",
            "description": "必须来自 list_automation_runs 或 execute_automation 返回结果。",
            "x-source": "value_ref",
            "x-value-ref-kinds": ["automation_run"]
          }
        },
        "required": ["automation_run_ref"]
      }
    }
  ]
}
