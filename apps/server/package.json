{
  "name": "geo-agent-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "dev:supervised": "tsx src/main.ts",
    "build": "npm run build --workspace @geo-agent-platform/db && node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "node scripts/run-vitest-with-env.mjs run src",
    "test:watch": "node scripts/run-vitest-with-env.mjs src"
  },
  "dependencies": {
    "@better-auth/electron": "1.6.25",
    "@geo-agent-platform/db": "file:../../packages/db",
    "@geo-agent-platform/operations-supervisor": "file:../../packages/operations-supervisor",
    "@geo-agent-platform/shared-types": "file:../../packages/shared-types",
    "@hono/node-server": "^1.13.0",
    "@hono/zod-validator": "^0.8.0",
    "@openai/agents": "0.14.1",
    "@turf/turf": "^7.2.0",
    "ajv": "^8.20.0",
    "better-auth": "1.6.25",
    "busboy": "^1.6.0",
    "casbin": "^5.51.1",
    "cron-parser": "^5.6.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "geotiff": "3.0.5",
    "hono": "^4.7.0",
    "microsoft-cognitiveservices-speech-sdk": "^1.50.0",
    "mustache": "^4.2.0",
    "openai": "6.49.0",
    "p-queue": "^9.3.1",
    "pg": "^8.14.0",
    "pg-boss": "^12.25.1",
    "pino": "^10.3.1",
    "proj4": "2.21.0",
    "prom-client": "^15.1.3",
    "quick-lru": "7.3.0",
    "rate-limiter-flexible": "^11.2.0",
    "sharp": "0.35.3",
    "undici": "^7.29.0",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/mustache": "^4.2.6",
    "@types/node": "^24.12.2",
    "@types/pg": "^8.11.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.0",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
