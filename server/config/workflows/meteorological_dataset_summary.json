{
  "workflowId": "meteorological_dataset_summary",
  "name": "气象数据摘要",
  "description": "先确定性检查气象数据，再由智能体生成变量、时间、空间范围和可分析性摘要。",
  "version": "2.0.0",
  "revision": 1,
  "enabled": true,
  "parametersSchema": {
    "type": "object",
    "properties": { "datasetId": { "type": "string", "minLength": 1 } },
    "required": ["datasetId"],
    "additionalProperties": false
  },
  "defaultParameters": { "datasetId": "latest_upload" },
  "requiredTools": ["meteorological_inspect"],
  "requiresApproval": false,
  "timeoutSeconds": 900,
  "outputType": "conversation",
  "graph": {
    "schemaVersion": 1,
    "entryNodeId": "trigger",
    "viewport": { "x": 0, "y": 0, "zoom": 1 },
    "nodes": [
      { "nodeId": "trigger", "type": "trigger", "label": "接收数据目标", "description": "接收 datasetId 与分析目标。", "position": { "x": 40, "y": 120 }, "config": {} },
      { "nodeId": "inspect", "type": "tool", "label": "检查气象数据", "description": "读取变量、维度、时间和空间元数据。", "position": { "x": 330, "y": 120 }, "config": { "toolName": "meteorological_inspect", "arguments": { "dataset_id": { "source": "input", "path": "parameters.datasetId" } }, "approvalMode": "auto", "retry": { "maxAttempts": 2, "backoffSeconds": 2 } } },
      { "nodeId": "summarize", "type": "agent", "label": "生成中文摘要", "description": "只根据检查结果总结，不编造数据。", "position": { "x": 650, "y": 120 }, "config": { "promptTemplate": "用户目标：{{{input.prompt}}}\n下面是 meteorological_inspect 的真实结果：\n{{{nodes.inspect.json}}}\n请用中文说明变量、维度、时间范围、空间范围、可统计性和可制图性。不得补写结果中不存在的事实。", "executionMode": "auto", "reasoning": true, "retry": { "maxAttempts": 1, "backoffSeconds": 0 } } },
      { "nodeId": "output", "type": "output", "label": "摘要结果", "description": "输出摘要与数据检查结果。", "position": { "x": 990, "y": 120 }, "config": { "outputs": { "answer": { "source": "node", "nodeId": "summarize", "path": "response" }, "inspection": { "source": "node", "nodeId": "inspect", "path": "payload" } } } }
    ],
    "edges": [
      { "edgeId": "trigger-inspect", "sourceNodeId": "trigger", "targetNodeId": "inspect", "sourcePort": "default" },
      { "edgeId": "inspect-summary", "sourceNodeId": "inspect", "targetNodeId": "summarize", "sourcePort": "success" },
      { "edgeId": "summary-output", "sourceNodeId": "summarize", "targetNodeId": "output", "sourcePort": "success" }
    ]
  }
}
