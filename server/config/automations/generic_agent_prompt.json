{
  "automationId": "generic_agent_prompt",
  "name": "通用智能体任务",
  "description": "将输入目标交给智能体执行，并输出可继续追踪的会话结果。",
  "version": "2.0.0",
  "revision": 1,
  "enabled": true,
  "parametersSchema": { "type": "object", "additionalProperties": true },
  "defaultParameters": {},
  "requiredTools": [],
  "requiresApproval": false,
  "timeoutSeconds": 900,
  "outputType": "conversation",
  "graph": {
    "schemaVersion": 1,
    "entryNodeId": "trigger",
    "viewport": { "x": 0, "y": 0, "zoom": 1 },
    "nodes": [
      { "nodeId": "trigger", "type": "trigger", "label": "手动或定时触发", "description": "接收提示词和参数。", "position": { "x": 40, "y": 120 }, "config": {} },
      { "nodeId": "agent", "type": "agent", "label": "任务智能体", "description": "按目标自主选择已授权工具。", "position": { "x": 360, "y": 120 }, "config": { "promptTemplate": "{{{input.prompt}}}", "executionMode": "auto", "reasoning": true, "retry": { "maxAttempts": 1, "backoffSeconds": 0 } } },
      { "nodeId": "output", "type": "output", "label": "会话结果", "description": "输出智能体回答和关联运行。", "position": { "x": 700, "y": 120 }, "config": { "outputs": { "answer": { "source": "node", "nodeId": "agent", "path": "response" }, "runId": { "source": "node", "nodeId": "agent", "path": "runId" } } } }
    ],
    "edges": [
      { "edgeId": "trigger-agent", "sourceNodeId": "trigger", "targetNodeId": "agent", "sourcePort": "default" },
      { "edgeId": "agent-output", "sourceNodeId": "agent", "targetNodeId": "output", "sourcePort": "success" }
    ]
  }
}
