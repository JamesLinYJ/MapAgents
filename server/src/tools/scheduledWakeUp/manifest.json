{
  "id": "geo-platform-scheduled-wake-up",
  "name": "ScheduledWakeUp",
  "version": "1.0.0",
  "author": "GeoForge",
  "description": "系统定时唤醒工具，用于创建、查看、更新和删除 GeoForge 定时任务。",
  "language": "typescript",
  "tools": [
    {
      "name": "ScheduledWakeUp",
      "label": "定时唤醒",
      "description": "管理系统定时任务。v1 支持将 Workflow 作为定时目标。",
      "group": "system",
      "tags": ["scheduler", "workflow", "system"],
      "isReadOnly": false,
      "isDestructive": false,
      "jsonSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "operation": {
            "type": "string",
            "enum": ["list", "create", "update", "delete"],
            "description": "操作类型。"
          },
          "taskId": {
            "type": "string",
            "description": "更新或删除时的定时任务 ID。"
          },
          "targetKind": {
            "type": "string",
            "enum": ["workflow"],
            "description": "定时目标类型。v1 只支持 workflow。"
          },
          "targetId": {
            "type": "string",
            "description": "目标 ID，例如 workflowId。"
          },
          "title": {
            "type": "string",
            "description": "定时任务标题。"
          },
          "prompt": {
            "type": "string",
            "description": "定时触发时传给目标的提示词。"
          },
          "parameters": {
            "type": "object",
            "description": "目标参数。"
          },
          "cron": {
            "type": "string",
            "description": "5 字段 cron：分 时 日 月 周。"
          },
          "timezone": {
            "type": "string",
            "description": "IANA 时区，例如 Asia/Shanghai。"
          },
          "recurring": {
            "type": "boolean",
            "description": "是否周期执行。"
          },
          "enabled": {
            "type": "boolean",
            "description": "是否启用。"
          }
        },
        "required": ["operation"]
      }
    }
  ]
}
