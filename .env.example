APP_NAME=geo-agent-platform
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
APP_BASE_URL=http://127.0.0.1:8000
POSTGIS_PORT=55432
WORKER_PORT=8012
RUNTIME_ROOT=./runtime
GEOFORGE_SUPERVISOR_TOKEN_FILE=./runtime/ops/supervisor.token
GEOFORGE_LOCAL_ROOT_SECRET_FILE=./runtime/ops/local-root.secret
DATABASE_URL=postgresql://geo_agent:geo_agent@127.0.0.1:55432/geo_agent
MAP_TILE_TIMEOUT_MS=30000

BETTER_AUTH_URL=http://127.0.0.1:8000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_ALLOW_SIGN_UP=true
BETTER_AUTH_REQUIRE_EMAIL_VERIFICATION=false
BETTER_AUTH_MIN_PASSWORD_LENGTH=12
CSRF_HEADER_NAME=x-geoforge-csrf
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
TRUSTED_ORIGINS=geoforge://app,com.geoforge.desktop://auth/callback

# 仅限本机 development 演示：Main 自动建立真实 Better Auth 管理员会话，
# Renderer 不接触凭据；设为 false 即恢复交互式登录页。
GEOFORGE_DESKTOP_AUTO_AUTH=true
GEOFORGE_DESKTOP_AUTO_AUTH_EMAIL=admin@example.com
GEOFORGE_DESKTOP_AUTO_AUTH_NAME=GeoForge 本机演示管理员

WORKER_URL=http://127.0.0.1:8012
WORKER_SHARED_SECRET=replace-with-at-least-32-random-characters
ENABLED_TOOL_PROVIDERS=geo-platform-chart,geo-platform-geocode,geo-platform-plan,geo-platform-developer-tools,geo-platform-spatial,geo-platform-meteorology,geo-platform-public-weather,geo-platform-memory,geo-platform-media,geo-platform-scheduled-wake-up
DEVELOPER_TOOL_ALLOWED_ROOTS=.;./runtime
SEED_LAYERS_DIR=./infra/seeds/layers
OPEN_METEO_FORECAST_BASE_URL=https://api.open-meteo.com
OPEN_METEO_GEOCODING_BASE_URL=https://geocoding-api.open-meteo.com
OPEN_METEO_AIR_QUALITY_BASE_URL=https://air-quality-api.open-meteo.com
OPEN_METEO_TIMEOUT_MS=10000

DEFAULT_MODEL_PROVIDER=deepseek
DEFAULT_MODEL_NAME=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TOOL_SCHEMA_MODE=compatible
DEEPSEEK_RESULT_CACHE_ENABLED=true
DEEPSEEK_RESULT_CACHE_TTL_SECONDS=86400
DEEPSEEK_RESULT_CACHE_MAX_BYTES=262144
USAGE_DAILY_TOTAL_TOKEN_LIMIT=0
USAGE_MONTHLY_TOTAL_TOKEN_LIMIT=0
GEMINI_BASE_URL=
GEMINI_API_KEY=
GEMINI_MODEL=

AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastasia
AZURE_SPEECH_ENDPOINT=https://eastasia.api.cognitive.microsoft.com
AZURE_SPEECH_DEFAULT_LANGUAGE=zh-CN
AZURE_SPEECH_SUPPORTED_LANGUAGES=zh-CN,en-US,ja-JP,ko-KR
AZURE_SPEECH_DEFAULT_VOICE=zh-CN-XiaoxiaoNeural
