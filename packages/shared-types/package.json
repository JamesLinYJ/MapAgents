{
  "name": "@geo-agent-platform/shared-types",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "default": "./dist/index.js" },
    "./core": { "types": "./dist/core.d.ts", "import": "./dist/core.js", "default": "./dist/core.js" },
    "./conversation": { "types": "./dist/conversation.d.ts", "import": "./dist/conversation.js", "default": "./dist/conversation.js" },
    "./runtime": { "types": "./dist/runtime.d.ts", "import": "./dist/runtime.js", "default": "./dist/runtime.js" },
    "./platform": { "types": "./dist/platform.d.ts", "import": "./dist/platform.js", "default": "./dist/platform.js" },
    "./product-identity": {
      "types": "./dist/productIdentity.d.ts",
      "import": "./dist/productIdentity.js",
      "default": "./dist/productIdentity.js"
    },
    "./resources": { "types": "./dist/resources.d.ts", "import": "./dist/resources.js", "default": "./dist/resources.js" },
    "./transport": { "types": "./dist/transport.d.ts", "import": "./dist/transport.js", "default": "./dist/transport.js" },
    "./worker": { "types": "./dist/worker.d.ts", "import": "./dist/worker.js", "default": "./dist/worker.js" },
    "./operations": { "types": "./dist/operations.d.ts", "import": "./dist/operations.js", "default": "./dist/operations.js" },
    "./desktop": { "types": "./dist/desktop.d.ts", "import": "./dist/desktop.js", "default": "./dist/desktop.js" },
    "./local-operations": { "types": "./dist/localOperations.d.ts", "import": "./dist/localOperations.js", "default": "./dist/localOperations.js" },
    "./map": { "types": "./dist/map.d.ts", "import": "./dist/map.js", "default": "./dist/map.js" },
    "./release": { "types": "./dist/release.d.ts", "import": "./dist/release.js", "default": "./dist/release.js" }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "build:dev": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "typescript": "~6.0.2"
  }
}
