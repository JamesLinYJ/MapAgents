    "test": "vitest run src",
    "test:watch": "vitest src"
  },
  "dependencies": {
    "@geo-agent-platform/shared-types": "file:../shared-types",
    "concurrently": "10.0.3",
    "dotenv": "17.4.2",
    "pino": "10.3.1",
    "proper-lockfile": "4.1.2",
    "strip-ansi": "7.2.0",
    "systeminformation": "5.33.0",
    "tree-kill": "1.2.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "@types/proper-lockfile": "^4.1.4",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
