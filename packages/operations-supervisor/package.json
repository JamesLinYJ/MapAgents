{
  "name": "@geo-agent-platform/operations-supervisor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "geoforge-supervisor": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js"
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
