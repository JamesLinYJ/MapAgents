{
  "name": "geo-agent-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/server",
    "apps/web",
    "packages/shared-types",
    "packages/conversation-presentation",
    "packages/operations-supervisor"
  ],
  "//": "Python worker only hosts packages/gis-meteorology scientific execution.",
  "scripts": {
    "dev": "bash ./dev.sh",
    "dev:windows": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./dev.ps1 start",
    "dev:windows:status": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./dev.ps1 status",
    "dev:windows:stop": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./dev.ps1 stop",
    "console:windows": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./dev.ps1 console",
    "agent": "bash ./dev.sh agent",
    "agent:windows": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./dev.ps1 agent",
    "dev:server": "npm run dev --workspace geo-agent-server",
    "dev:web": "npm run dev --workspace apps/web",
    "dev:worker": "python -m uvicorn worker_app.sidecar:app --app-dir apps/worker/src --host 127.0.0.1 --port 8012 --reload",
    "build": "npm run build --workspace @geo-agent-platform/shared-types && npm run build --workspace @geo-agent-platform/conversation-presentation && npm run build --workspace @geo-agent-platform/operations-supervisor && npm run build --workspace geo-agent-server && npm run build --workspace apps/web",
    "build:presentation": "npm run build --workspace @geo-agent-platform/conversation-presentation",
    "build:supervisor": "npm run build --workspace @geo-agent-platform/operations-supervisor",
    "build:server": "npm run build --workspace geo-agent-server",
    "build:web": "npm run build --workspace apps/web",
    "test": "npm run build --workspace @geo-agent-platform/shared-types && npm run test --workspace @geo-agent-platform/conversation-presentation && npm run test --workspace @geo-agent-platform/operations-supervisor && npm run test --workspace geo-agent-server && npm run test --workspace apps/web",
    "test:presentation": "npm run test --workspace @geo-agent-platform/conversation-presentation",
    "test:supervisor": "npm run test --workspace @geo-agent-platform/operations-supervisor",
    "test:server": "npm run test --workspace geo-agent-server",
    "test:web": "npm run test --workspace apps/web",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "lint:web": "npm run lint --workspace apps/web",
    "lint:terminology": "node scripts/check-meteorology-terminology.mjs",
    "generate:glass": "node scripts/generate-liquid-glass-maps.mjs",
    "check:bundle": "node scripts/check-web-bundle-budget.mjs",
    "reset:conversations": "node scripts/reset-conversation-store.mjs --confirm"
  },
  "dependencies": {
    "@openai/agents": "0.13.5",
    "openai": "6.48.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0"
  }
}
