# Terminal Broker 最小环境。禁止加入数据库、模型、认证或 Process Compose 密钥。
NODE_ENV=production
NODE_EXECUTABLE=<absolute-node-executable>
OPS_EXPECTED_SERVICE_USER=<terminal-service-account-short-name>
OPS_BROKER_HOST=127.0.0.1
OPS_BROKER_PORT=8021
OPS_BROKER_SHARED_SECRET=<same-random-secret-as-ops-gateway-broker-secret>
OPS_TERMINAL_SPOOL_ROOT=<absolute-private-spool-directory>
OPS_WORKSPACE_ROOT=.
OPS_WINDOWS_SHELL=<absolute-pwsh-executable>
OPS_LINUX_SHELL=/bin/bash
