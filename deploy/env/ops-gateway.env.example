# Ops Gateway 专属环境。不得加入模型 API Key；文件只授予 Gateway 服务账户读取。
NODE_ENV=production
NODE_EXECUTABLE=<absolute-node-executable>
OPS_EXPECTED_SERVICE_USER=<gateway-service-account-short-name>
OPS_GATEWAY_HOST=127.0.0.1
OPS_GATEWAY_PORT=8020
OPS_PUBLIC_BASE_URL=https://geoforge.example.com
OPS_ALLOWED_ORIGINS=https://geoforge.example.com
OPS_STATIC_ROOT=apps/operations/dist
OPS_BROKER_URL=http://127.0.0.1:8021
OPS_BROKER_SHARED_SECRET=<independent-random-secret-at-least-32-characters>
OPS_RECOVERY_SECRET=<different-random-secret-at-least-32-characters>
OPS_MASTER_KEYRING_FILE=<absolute-secure-keyring-file>
OPS_ACTIVE_KEY_ID=<active-key-id>
PROCESS_COMPOSE_URL=http://127.0.0.1:8080
PROCESS_COMPOSE_TOKEN_FILE=<absolute-secure-token-file>
DATABASE_URL=<postgresql-connection-string>
RUNTIME_ROOT=runtime
BETTER_AUTH_SECRET=<third-independent-random-secret-at-least-32-characters>
BETTER_AUTH_ALLOW_SIGN_UP=false
BETTER_AUTH_REQUIRE_EMAIL_VERIFICATION=true
BETTER_AUTH_MIN_PASSWORD_LENGTH=12
CSRF_HEADER_NAME=x-geoforge-csrf
