# GeoForge 主业务监督进程环境。复制到受 ACL 保护的位置后替换所有占位值。
NODE_ENV=production
PROCESS_COMPOSE_TOKEN_FILE=<absolute-secure-token-file>
PROC_COMP_CONFIG=<absolute-process-compose-config-directory>
PROCESS_COMPOSE_LOG_FILE=<absolute-process-compose-log-file>
WORKER_PYTHON=<absolute-python-executable>
WORKER_PORT=8012
WORKER_PROCESSES=1
API_HOST=127.0.0.1
API_PORT=8000
WEB_STATIC_HOST=127.0.0.1
WEB_STATIC_PORT=5173
RUNTIME_ROOT=runtime
DATABASE_URL=<postgresql-connection-string>
WORKER_URL=http://127.0.0.1:8012
WORKER_SHARED_SECRET=<independent-random-secret>
BETTER_AUTH_SECRET=<independent-random-secret>
BETTER_AUTH_ALLOW_SIGN_UP=false
BETTER_AUTH_REQUIRE_EMAIL_VERIFICATION=true
APP_BASE_URL=https://geoforge.example.com
WEB_BASE_URL=https://geoforge.example.com
TRUSTED_ORIGINS=https://geoforge.example.com
MARTIN_INTERNAL_URL=http://127.0.0.1:3000
TITILER_INTERNAL_URL=http://127.0.0.1:8001
DEFAULT_MODEL_PROVIDER=deepseek
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=<model-api-key>
DEEPSEEK_MODEL=<model-name>
