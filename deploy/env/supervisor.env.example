# GeoForge 生产监督器环境（所有路径必须替换为绝对路径）
NODE_ENV=production
GEOFORGE_ROOT=/opt/geoforge/releases/0.1.0
RUNTIME_ROOT=/var/lib/geoforge/runtime
GEOFORGE_SUPERVISOR_TOKEN_FILE=/var/lib/geoforge/runtime/secrets/supervisor.token
GEOFORGE_LOCAL_ROOT_SECRET_FILE=/etc/geoforge/local-root.secret
GEOFORGE_OPERATORS_PRINCIPAL=GeoForge Operators
POSTGIS_PORT=5432
WORKER_PORT=8012
API_HOST=127.0.0.1
API_PORT=8000
WORKER_PYTHON=/opt/geoforge/venv/bin/python
WORKER_PROCESSES=2
DATABASE_URL=postgresql://replace-me
WORKER_URL=http://127.0.0.1:8012
APP_BASE_URL=http://127.0.0.1:8000
TRUSTED_ORIGINS=geoforge://app,com.geoforge.desktop://auth/callback
BETTER_AUTH_URL=http://127.0.0.1:8000
BETTER_AUTH_SECRET=replace-with-a-production-secret
WORKER_SHARED_SECRET=replace-with-a-production-secret
ENABLED_TOOL_PROVIDERS=geo-platform-chart,geo-platform-geocode,geo-platform-plan,geo-platform-spatial,geo-platform-meteorology,geo-platform-public-weather,geo-platform-memory,geo-platform-media,geo-platform-scheduled-wake-up
