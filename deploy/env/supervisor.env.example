# 地理智能平台生产监督器环境（所有路径必须替换为绝对路径）
NODE_ENV=production
GEO_AGENT_PLATFORM_ROOT=/opt/geo-agent-platform/releases/0.1.0
RUNTIME_ROOT=/var/lib/geo-agent-platform/runtime
GEO_AGENT_PLATFORM_SUPERVISOR_TOKEN_FILE=/var/lib/geo-agent-platform/runtime/secrets/supervisor.token
GEO_AGENT_PLATFORM_LOCAL_ROOT_SECRET_FILE=/etc/geo-agent-platform/local-root.secret
GEO_AGENT_PLATFORM_OPERATORS_PRINCIPAL=Geo Agent Platform Operators
POSTGIS_PORT=5432
WORKER_PORT=8012
API_HOST=127.0.0.1
API_PORT=8000
WORKER_PYTHON=/opt/geo-agent-platform/venv/bin/python
WORKER_PROCESSES=2
WORKER_MAX_CONCURRENCY=2
WORKER_NONCE_CACHE_MAX=10000
WORKER_NONCE_STORE_PATH=/var/lib/geo-agent-platform/runtime/.worker-nonces.sqlite3
WORKER_CONCURRENCY_STORE_PATH=/var/lib/geo-agent-platform/runtime/.worker-concurrency.sqlite3
WORKER_CONCURRENCY_LEASE_SECONDS=330
WORKER_TOOL_TIMEOUT_SECONDS=300
DATABASE_URL=postgresql://replace-me
WORKER_URL=http://127.0.0.1:8012
APP_BASE_URL=http://127.0.0.1:8000
TRUSTED_ORIGINS=geo-agent-platform://app,com.geo-agent-platform.desktop://auth/callback
BETTER_AUTH_URL=http://127.0.0.1:8000
BETTER_AUTH_SECRET=replace-with-a-production-secret
WORKER_SHARED_SECRET=replace-with-a-production-secret
ENABLED_TOOL_PROVIDERS=geo-platform-chart,geo-platform-geocode,geo-platform-plan,geo-platform-spatial,geo-platform-meteorology,geo-platform-public-weather,geo-platform-memory,geo-platform-media,geo-platform-scheduled-wake-up
