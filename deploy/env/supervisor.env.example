# GeoForge 生产监督器环境（所有路径必须替换为绝对路径）
NODE_ENV=production
RUNTIME_ROOT=/var/lib/geoforge/runtime
GEOFORGE_SUPERVISOR_TOKEN_FILE=/etc/geoforge/supervisor.token
GEOFORGE_LOCAL_ROOT_SECRET_FILE=/etc/geoforge/local-root.secret
GEOFORGE_OPERATORS_PRINCIPAL=GeoForge Operators
POSTGIS_PORT=5432
MARTIN_PORT=3000
TITILER_PORT=8001
WORKER_PORT=8012
API_PORT=8000
WEB_STATIC_PORT=4173
WORKER_PYTHON=/opt/geoforge/venv/bin/python
WORKER_PROCESSES=2
DATABASE_URL=postgresql://replace-me
WORKER_URL=http://127.0.0.1:8012
MARTIN_INTERNAL_URL=http://127.0.0.1:3000
TITILER_INTERNAL_URL=http://127.0.0.1:8001
APP_BASE_URL=https://replace-me.example
WEB_BASE_URL=https://replace-me.example
BETTER_AUTH_URL=https://replace-me.example
TRUSTED_ORIGINS=https://replace-me.example
BETTER_AUTH_SECRET=replace-with-a-production-secret
WORKER_SHARED_SECRET=replace-with-a-production-secret
