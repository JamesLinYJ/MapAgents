<service>
  <id>GeoForgeProcessCompose</id>
  <name>GeoForge Process Compose</name>
  <description>Supervises GeoForge web, api, worker and infrastructure.</description>
  <executable>@@PWSH_EXECUTABLE@@</executable>
  <arguments>-NoProfile -NonInteractive -File "@@GEOFORGE_ROOT@@\scripts\run-geoforge-windows-service.ps1" -Component ProcessCompose -EnvironmentFile "@@SERVICE_ENV_FILE@@"</arguments>
  <workingdirectory>@@GEOFORGE_ROOT@@</workingdirectory>
  <startmode>Automatic</startmode>
  <stoptimeout>60sec</stoptimeout>
  <onfailure action="restart" delay="5 sec" />
  <log mode="roll-by-size-time"><sizeThreshold>10240</sizeThreshold><pattern>yyyyMMdd</pattern><autoRollAtTime>00:00:00</autoRollAtTime><zipOlderThanNumDays>7</zipOlderThanNumDays></log>
</service>
