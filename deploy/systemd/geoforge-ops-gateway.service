[Unit]
Description=GeoForge Operations Gateway
After=network-online.target geoforge-process-compose.service geoforge-terminal-broker.service
Wants=network-online.target geoforge-terminal-broker.service
Requires=geoforge-process-compose.service

[Service]
Type=simple
User=geoforge-ops
Group=geoforge-ops
WorkingDirectory=@@GEOFORGE_ROOT@@
EnvironmentFile=/etc/geoforge/ops-gateway.env
ExecStart=/usr/bin/node @@GEOFORGE_ROOT@@/server/dist/operations/opsGatewayRuntime.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=@@GEOFORGE_ROOT@@/runtime

[Install]
WantedBy=multi-user.target
