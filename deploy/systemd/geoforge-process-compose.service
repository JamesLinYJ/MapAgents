[Unit]
Description=GeoForge Process Compose Supervisor
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=geoforge
Group=geoforge
WorkingDirectory=@@GEOFORGE_ROOT@@
EnvironmentFile=/etc/geoforge/geoforge.env
ExecStart=@@GEOFORGE_ROOT@@/runtime/tools/process-compose/1.120.0/process-compose --address 127.0.0.1 --port 8080 --token-file /etc/geoforge/process-compose.token --ordered-shutdown -f @@GEOFORGE_ROOT@@/config/process-compose.production.linux.yaml up --disable-dotenv --tui=false
ExecStop=@@GEOFORGE_ROOT@@/runtime/tools/process-compose/1.120.0/process-compose --address 127.0.0.1 --port 8080 --token-file /etc/geoforge/process-compose.token down
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
